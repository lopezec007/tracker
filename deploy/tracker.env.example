# Tracker service configuration.
#
# Copy to /etc/tracker/tracker.env (deploy/install.sh does this on first
# install and never overwrites it afterwards). Lines are KEY=VALUE, read by
# systemd's EnvironmentFile=; after editing run: systemctl restart tracker
#
# Everything is commented out below, i.e. the defaults from tracker.service
# apply.

# Address to listen on. 0.0.0.0 makes the API reachable from the whole LAN;
# use 127.0.0.1:8081 to restrict it to this machine (e.g. behind a reverse
# proxy). Ports below 1024 need the capability change noted in
# tracker.service.
#TRACKER_ADDR=0.0.0.0:8081

# Path to the SQLite database. The default is inside the systemd
# StateDirectory, which is the only writable location under the unit's
# hardening; if you move it elsewhere, add that path to ReadWritePaths= in
# the unit.
#TRACKER_DB=/var/lib/tracker/tracker.db
